{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": []
    },
    {
      "name": "Release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--release"
      ]
    },
    {
      "name": "Profile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--profile"
      ]
    },
    {
      "name": "Pixel",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator-5554"
    },
    {
      "name": "smallDevice",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator-5556"
    },
    {
      "name": "Web Server",
      "request": "launch",
      "type": "dart",
      "deviceId": "web-server"
    }
  ],
  "compounds": [
    {
      "name": "All Devices",
      "configurations": [
        "Pixel",
        "smallDevice"
      ]
    }
  ]
}