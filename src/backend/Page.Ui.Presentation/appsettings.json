{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore": "Warning"
                                 }
                },
    "Database": {
      "ApplyMigrationsOnStartup": false,
      "Pooling": {
        "Enabled": true,
        "MinimumPoolSize": 5,
        "MaximumPoolSize": 60,
        "TimeoutSeconds": 15,
        "CommandTimeoutSeconds": 30,
        "ConnectionIdleLifetimeSeconds": 300,
        "ConnectionPruningIntervalSeconds": 10
      }
    },
    "Serilog": {
      "Using": [ "Serilog.Sinks.Async", "Serilog.Sinks.Console" ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
      },
      "Enrich": [ "FromLogContext" ],
      "WriteTo": [
        {
          "Name": "Async",
          "Args": {
            "configure": [
              {
                "Name": "Console"
              }
            ]
          }
        }
      ]
    },
    "AllowedHosts":  "*",
    "Cors": {
      "AllowAnyOriginInDevelopment": true,
      "AllowedOrigins": []
    },
    "Chat": {
      "DisplayTimeZone": "Africa/Cairo"
    },
    "Security":  {
                     "DataProtectionKeysPath":  "secrets/data-protection",
                     "RsaPrivateKeyPath":  "secrets/rsa/private.key",
                     "RsaPublicKeyPath":  "secrets/rsa/public.key"
                 }
}
